import sys
import re

dados = open("BACKING_STORE.bin", "rb").read()
verificados = 0
erros = 0

for linha in sys.stdin:
    if not linha.startswith("Endereco logico:"):
        continue

    numero = int(re.search(r"Endereco logico: (\d+)", linha).group(1))
    endereco = numero & 0xFFFF
    valor = dados[endereco]
    if valor >= 128:
        valor -= 256

    # A comparação completa com a saída física será feita na próxima etapa.
    verificados += 1

print("Enderecos processados:", verificados)
print("Total esperado:", 1000)
'
